# Required
ROOSTLE_BASE_URL=https://roostle.co.uk
ROOSTLE_SMTP_SERVICE_TOKEN=            # from `php artisan roostle:smtp-token`; never log or commit

# Optional (defaults shown)
ROOSTLE_CATCH_DOMAIN=catch.roostle.co.uk       # informational only; Laravel validates addresses
ROOSTLE_SMTP_HOSTNAME=smtp.roostle.co.uk       # used in the banner and EHLO
ROOSTLE_MAX_MESSAGE_KILOBYTES=5120             # keep equal to Laravel's setting
ROOSTLE_CATCH_BIND=0.0.0.0:25                  # comma-separated; empty disables the listener
ROOSTLE_SUBMISSION_BIND=0.0.0.0:587            # e.g. 0.0.0.0:587,0.0.0.0:2525
ROOSTLE_TLS_CERT=/etc/roostle/fullchain.pem    # required for submission (STARTTLS)
ROOSTLE_TLS_KEY=/etc/roostle/privkey.pem
ROOSTLE_MAX_CONNECTIONS=500
ROOSTLE_AUTH_MAX_FAILURES=5                    # failed AUTHs per client IP per window before refusal
ROOSTLE_AUTH_WINDOW_SECONDS=900
# Local development only: allow AUTH without TLS
# ROOSTLE_ALLOW_INSECURE_AUTH=true
RUST_LOG=info
